{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api-server": {
      "root": "services/api-server",
      "runtime": "go",
      "entrypoint": "main.go",
      "bindings": [
        {
          "type": "service",
          "service": "telegram-bot",
          "format": "url",
          "env": "SIDECAR_URL"
        }
      ]
    },
    "telegram-bot": {
      "root": "services/telegram-bot",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/dl/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/is_member",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
